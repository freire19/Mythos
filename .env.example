# Google Gemini (optional, vision-capable via OpenAI-compatible endpoint)
# Get your API key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza-your-key-here
# GEMINI_MODEL=gemini-3.1-pro-preview-customtools  # default chat; flash: gemini-3.5-flash; lite: gemini-3.1-flash-lite-preview
# GEMINI_OCR_MODEL=gemini-3.5-flash  # default OCR; usado quando provider principal nao tem visao

# DeepSeek (default provider)
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro   # default; flash: deepseek-v4-flash; vision: web-only beta (chat.deepseek.com), API nao suporta

# OpenAI (optional)
# OPENAI_API_KEY=sk-your-key-here

# Anthropic / Claude (optional)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6   # default; opus: claude-opus-4-7, fast: claude-haiku-4-5-20251001
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1   # override para self-hosted/proxy

# Grok / xAI (optional)
# GROK_API_KEY=xai-your-key-here

# Ollama / local models (no API key needed)
# OLLAMA_API_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:14b
# OLLAMA_GEMMA_12B_MODEL=gemma3:12b
# OLLAMA_GEMMA_27B_MODEL=gemma3:27b

# Default provider: deepseek, openai, anthropic, grok, ollama, google, gemma-12b, gemma-27b
# ALPHA_PROVIDER=deepseek

# Default named agent profile (loads agents/<name>/agent.yaml)
# ALPHA_AGENT=default

# Agent workspace (defaults to current directory)
# AGENT_WORKSPACE=/home/user/projects

# Browser tool policy
# ALPHA_BROWSER_ALLOWLIST=example.com,docs.python.org
# ALPHA_BROWSER_BLOCKLIST=evil.com
# ALPHA_BROWSER_REQUIRE_ALLOWLIST=1   # fail-closed when allowlist is empty

# Apify (scraping via apify_run_actor / apify_search_actors)
# APIFY_API_TOKEN=apify_api_xxx

# Disable ANSI colors in terminal output
# NO_COLOR=1

# Sub-agent (#D007): politica de bloqueio quando sub-agent roda sem
# approval callback (modo daemon / non-interactive).
# - "strict" (default): bloqueia tools destrutivas — so usa safe + git ro.
# - "relaxed": deixa o sub-agent usar tudo exceto delegate_* (anti-recursao).
#   So use se voce confia totalmente no prompt do parent.
# ALPHA_SUBAGENT_POLICY=strict
# Tools extras a bloquear (alem do default). Comma-separated.
# ALPHA_SUBAGENT_EXTRA_BLOCK=write_file,edit_file
# Tools a permitir mesmo se estiverem na blocklist default.
# ALPHA_SUBAGENT_ALLOW=execute_shell

# Cost caps (Plano-v3 pre_flight). Sem cap = ilimitado.
# ALPHA_MAX_TURN_COST_USD=0.50      # gate do pre_flight: bloqueia um turno acima deste valor
# ALPHA_MAX_SESSION_COST_USD=5.00   # cap acumulado por sessao (agent aborta se exceder)

# Context override. Use para forcar token budget custom (default vem de config.py LIMITS).
# ALPHA_CONTEXT_LIMIT=64000

# Output token cap por resposta (Anthropic). Default 8192; suba para geracoes
# longas (refactors grandes, reescrita de arquivo inteiro).
# ALPHA_MAX_TOKENS=32000

# Prompt caching Anthropic (cache_control ephemeral em system/tools/prefixo).
# Ligado por padrao — corta custo/latencia em turnos longos. Desligue apenas
# se um proxy rejeitar o campo cache_control.
# ALPHA_ANTHROPIC_CACHE=0

# Extended thinking (Anthropic). Tri-state: auto (default, liga para modelos
# que suportam — Claude 3.7+ / familias 4+) | on | off. O budget de raciocinio
# e adicional ao ALPHA_MAX_TOKENS (min 1024, default 4096).
# ALPHA_ANTHROPIC_THINKING=off
# ALPHA_THINKING_BUDGET=8192

# Gating de familias de tools (reduz a superficie do prompt). Tri-state:
# auto (default) | on | off. Em "auto", browser tools so sao oferecidas ao
# modelo se o Playwright estiver instalado; apify tools so com APIFY_API_TOKEN.
# Force off para enxugar ainda mais o prompt quando nao usar o recurso.
# ALPHA_BROWSER_TOOLS=off
# ALPHA_APIFY_TOOLS=off

# Sandboxing. Forca docker sandbox mesmo quando heuristic nao detectaria.
# ALPHA_SANDBOX=1

# Logging. Emite logs em JSONL stdout para ingestao (Loki, Datadog, etc.).
# ALPHA_JSON_LOGS=1

# Display tweaks (terminais antigos / non-TTY).
# ALPHA_SIMPLE_INPUT=1              # fallback de input sem prompt_toolkit
# ALPHA_NO_SCROLL_REGION=1          # desliga ANSI scroll region (tmux antigo)
# ALPHA_NO_PROJECT_CONTEXT=1        # nao carrega ALPHA.md do projeto

# Tooling. Permitir pip install global (default exige venv ativo — #050).
# ALPHA_ALLOW_GLOBAL_PIP=1

# Testing/Replay. Grava todos os eventos da sessao para fixtures de regressao.
# ALPHA_RECORD_SESSION_PATH=/tmp/alpha-session.jsonl
